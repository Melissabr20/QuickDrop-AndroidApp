                <!--userinfo-->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/circularbordersolid"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:id="@+id/profileinfo"
                    >
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:tint="@color/blue"
                        android:padding="10dp"
                        android:src="@drawable/ic_baseline_person_24" />


                    <TextView
                        android:id="@+id/personalinfobtn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="13dp"
                        android:text="Profile"
                        android:clickable="true"
                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="15dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/circularbordersolid"
                    android:gravity="center"
                    android:orientation="horizontal"
                    >
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:padding="10dp"
                        app:tint="@color/blue"
                        android:src="@drawable/security" />


                    <TextView
                        android:id="@+id/securitybtn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="13dp"
                        android:text="Securité"
                        android:clickable="true"
                        android:onClick="security"
                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/circularbordersolid"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:tint="@color/blue"
                        android:padding="10dp"
                        android:src="@drawable/setting" />


                    <TextView
                        android:id="@+id/settingsbtn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="13dp"
                        android:text="Paramètres"

                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:clickable="true"
                        />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/circularbordersolid"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:tint="@color/blue"
                        android:padding="10dp"
                        android:src="@drawable/help_web_button" />


                    <TextView
                        android:id="@+id/aboutusbtn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="13dp"
                        android:text="À Propos de Nous"
                        android:clickable="true"
                        android:onClick="about"
                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/circularbordersolid"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="50dp"
                        app:tint="@color/blue"
                        android:padding="10dp"
                        android:layout_height="50dp"
                        android:src="@drawable/share" />


                    <TextView
                        android:id="@+id/sharebtn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="13dp"
                        android:text="Partager"
                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:onClick="share"/>

                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:background="@drawable/circularbordersolid"
                    android:gravity="center"
                    android:orientation="horizontal">
                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        app:tint="@color/blue"
                        android:padding="10dp"
                        android:src="@drawable/help_web_button" />


                    <TextView
                        android:id="@+id/helpbtn"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/inter_semibold"
                        android:padding="13dp"
                        android:text="Page d'aide"
                        android:textColor="@color/blue"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:onClick="help"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>


    </RelativeLayout>

</FrameLayout>