<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">


        <TextView
            android:id="@+id/skip"
            android:layout_width="fill_parent"
            android:layout_height="90dp"
            android:layout_gravity="right"
            android:gravity="right"
            android:paddingRight="23dp"
            android:paddingTop="43dp"
            android:fontFamily="@font/dm_medium"
            android:text=""
            android:textColor="@color/orange"
            android:textSize="20sp"
            android:clickable="true"
            android:onClick="skiptohome"


            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="390dp">

            <ImageView
                android:id="@+id/homeimg"
                android:layout_width="match_parent"
                android:layout_height="376dp"
                app:srcCompat="@drawable/addtocart" />
        </LinearLayout>


        <TextView
            android:layout_width="390dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:fontFamily="@font/fresca"
            android:gravity="center"
            android:text="Bienvenue sur QuickDrop"
            android:textColor="@color/Linear"
            android:textSize="30sp"


            />

        <TextView
            android:layout_width="260dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:fontFamily="@font/dm_medium"
            android:gravity="center"
            android:text="Welcome to Algeria’s Best online shopping destination"
            android:textColor="@color/black"
            android:textSize="14sp"/>


        <LinearLayout
            android:layout_width="280dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="15dp">


            <Button
                android:id="@+id/btnsignup"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_medium"
                android:onClick="register"
                android:padding="20dp"
                android:text="S'inscrire"

                android:textColor="@color/white"
                android:textSize="18sp"
                app:backgroundTint="@color/orange"
                app:cornerRadius="15dp"
                android:textAllCaps="false"/>

            <TextView
                android:layout_width="182dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"

                android:clickable="true"
                android:fontFamily="@font/dm_bold"
                android:gravity="center"

                android:onClick="login"
                android:text="Se connecter"
                android:textColor="@color/button_color"
                android:textSize="20sp"



                />


        </LinearLayout>





    </LinearLayout>







</RelativeLayout>