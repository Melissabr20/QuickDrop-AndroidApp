<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"


    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:background="@color/app_color">





        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-15dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                android:layout_marginTop="15dp"

                >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registeusername"
                    android:drawableLeft="@drawable/ic_baseline_person_24"
                    android:background="@drawable/edittext_background"

                    android:hint=" Username "
                    android:textColorHint="@color/black"

                    app:hintTextColor="@color/black"
                    android:inputType="text"
                    app:drawableTint="@color/button_color"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                >


                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/firstname"
                    android:drawableLeft="@drawable/ic_baseline_person_24"
                    android:background="@drawable/edittext_background"
                    android:hint=" Nom "
                    android:textColorHint="@color/black"
                    app:hintTextColor="@color/black"
                    android:inputType="text"
                    app:drawableTint="@color/button_color"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                >


                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/lastname"
                    android:drawableLeft="@drawable/ic_baseline_person_24"
                    android:background="@drawable/edittext_background"
                    android:hint=" Prenom"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@color/black"
                    android:inputType="text"
                    app:drawableTint="@color/button_color"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>



            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                >


                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registeremail"
                    android:drawableLeft="@drawable/ic_baseline_email_24"
                    android:background="@drawable/edittext_background"
                    android:hint=" Adresse email"
                    android:textColorHint="@color/black"
                    app:boxStrokeColor="@color/icon_color"
                    app:hintTextColor="@color/black"
                    android:inputType="textEmailAddress"
                    app:drawableTint="@color/button_color"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"


                >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registphone"
                    android:drawableLeft="@drawable/baseline_call_24"
                    android:background="@drawable/edittext_background"

                    android:hint=" numero de tel"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@color/black"

                    android:inputType="text"
                    app:drawableTint="@color/button_color"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>




            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/icon_color"
                app:hintTextColor="@color/black">


                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registermdp"
                    android:drawableStart="@drawable/ic_baseline_lock_24"
                    android:background="@drawable/edittext_background"
                    android:inputType="textPassword"
                    android:hint=" mot de passe"
                    android:textColorHint="@color/black"
                    app:drawableTint="@color/button_color"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"

                >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registaddress"
                    android:drawableLeft="@drawable/baseline_edit_location_24"
                    android:background="@drawable/edittext_background"

                    android:hint=" Adresse"
                    android:textColorHint="@color/black"
                    app:hintTextColor="@color/black"

                    android:inputType="text"
                    app:drawableTint="@color/button_color"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/btnsignup"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_medium"
                android:onClick="register"
                android:padding="20dp"
                android:layout_marginTop="30dp"
                android:text="Register"

                android:textColor="@color/white"
                android:textSize="20sp"
                app:backgroundTint="@color/button_color"
                app:cornerRadius="15dp"
                android:textAllCaps="false"
                android:layout_gravity="center"
                android:gravity="center"/>




        </LinearLayout>


    </LinearLayout>


</RelativeLayout>