<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounded_corners"
    tools:context=".ArticleDetails"
    >


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_corners"
        android:orientation="vertical"
        android:padding="10dp"
        >

        <ImageView
            android:id="@+id/prdimg"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/edittext_background">

            <ImageView
                android:id="@+id/moinsid"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="remove piece "
                android:onClick="moins"
                android:src="@drawable/baseline_horizontal_rule_24" />

            <Space
                android:layout_width="15dp"
                android:layout_height="wrap_content"

                />

            <TextView
                android:id="@+id/quantitetext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_bold"
                android:paddingTop="6dp"
                android:paddingBottom="5dp"
                android:text="1"
                android:textSize="30sp" />

            <Space
                android:layout_width="15dp"
                android:layout_height="wrap_content"

                />

            <ImageView
                android:id="@+id/plusid"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:clickable="true"
                android:contentDescription="add piece"
                android:onClick="plus"
                android:src="@drawable/baseline_add_24" />

        </LinearLayout>


        <TextView
            android:id="@+id/prdname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/inter_bold"
            android:paddingTop="6dp"
            android:paddingBottom="5dp"
            android:textColor="@color/orange"
            android:text="Gaming"
            android:textSize="25sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/prdprice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="6dp"
                android:text="Gaming"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentEnd="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="5dp"
                android:layout_marginTop="15dp"
                android:fontFamily="@font/inter_semibold"
                android:paddingTop="6dp"
                android:text="DZD"
                android:textColor="@color/black"
                android:textSize="20sp" />

            <Space
                android:layout_width="50dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                />


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/inter_bold"
                android:paddingBottom="5dp"
                android:text="Description de l'article :"
                android:textColor="@color/black"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/prddesignation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:fontFamily="@font/inter_bold"
                android:padding="6dp"
                android:paddingBottom="10dp"
                android:text="Gaming"
                android:textColor="@color/text_color"
                android:textSize="15sp" />

        </LinearLayout>

        <Button
            android:id="@+id/AddCart"
            android:layout_width="305dp"
            android:layout_height="wrap_content"
            android:layout_below="@id/orderDetails"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/button_color"
            android:padding="15dp"
            android:text="Ajouter au Panier"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/inter_bold"/>


    </LinearLayout>
</RelativeLayout>