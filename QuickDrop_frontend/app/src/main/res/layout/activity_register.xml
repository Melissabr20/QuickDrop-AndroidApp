<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_color"
    tools:context=".Login">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            app:srcCompat="@drawable/sign_up" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"

            android:text="Join Us"
            android:textColor="@color/gris"
            android:fontFamily="@font/inter_semibold"
            android:textSize="32sp"
            android:layout_marginStart="9dp"/>




        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="-15dp"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                android:layout_marginTop="15dp"

                >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registeusername"
                    android:drawableLeft="@drawable/ic_baseline_person_24"
                    android:background="@drawable/edittext_background"

                    android:hint=" Nom d'utilisateur"
                    android:textColorHint="@color/black"

                    app:boxStrokeColor="@color/icon_color"
                    app:hintTextColor="@color/black"

                    android:inputType="text"
                    app:drawableTint="@color/orange"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>



            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                >


                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registeremail"
                    android:drawableLeft="@drawable/ic_baseline_email_24"
                    android:background="@drawable/edittext_background"
                    android:hint=" Adresse email"
                    android:textColorHint="@color/black"
                    app:boxStrokeColor="@color/icon_color"
                    app:hintTextColor="@color/black"
                    android:inputType="textEmailAddress"
                    app:drawableTint="@color/orange"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"


                >

                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registphone"
                    android:drawableLeft="@drawable/baseline_call_24"
                    android:background="@drawable/edittext_background"

                    android:hint=" numero de tel"
                    android:textColorHint="@color/black"

                    app:boxStrokeColor="@color/icon_color"
                    app:hintTextColor="@color/black"

                    android:inputType="text"
                    app:drawableTint="@color/orange"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>



            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:layout_marginBottom="9dp"
                app:passwordToggleEnabled="true"


                app:boxStrokeColor="@color/icon_color"
                app:passwordToggleTint="@color/icon_color"
                app:hintTextColor="@color/black">


                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:id="@+id/registermdp"
                    android:drawableStart="@drawable/ic_baseline_lock_24"
                    android:background="@drawable/edittext_background"
                    android:inputType="textPassword"
                    android:hint=" mot de passe"
                    android:textColorHint="@color/black"
                    app:drawableTint="@color/orange"
                    android:textColor="@color/black"/>

            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/btnsignup"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dm_medium"
                android:onClick="register"
                android:padding="20dp"
                android:layout_marginTop="20dp"
                android:text="S'inscrire"

                android:textColor="@color/white"
                android:textSize="20sp"
                app:backgroundTint="@color/orange"
                app:cornerRadius="15dp"
                android:textAllCaps="false"
                android:layout_gravity="center"
                android:gravity="center"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"


                    android:fontFamily="@font/dm_medium"
                    android:padding="5dp"
                    android:text="vous avez deja un compte ?"
                    android:textColor="@color/gris"
                    android:textSize="17sp" />




            </LinearLayout>

            <TextView
                android:id="@+id/connecter"
                android:layout_width="218dp"
                android:layout_height="48dp"
                android:layout_gravity="center"

                android:fontFamily="@font/dm_bold"
                android:gravity="center"
                android:onClick="login"

                android:text="Se connecter"
                android:textColor="@color/button_color"
                android:textSize="23sp"


                />


        </LinearLayout>


    </LinearLayout>


</RelativeLayout>