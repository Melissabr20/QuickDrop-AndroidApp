<?xml version="1.0" encoding="utf-8"?>

<!-- bottom_sheet_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_corners"
    >
    <LinearLayout
        android:layout_height="match_parent"
        android:layout_width="match_parent"
        android:id="@+id/order_details"
        android:orientation="vertical"
        android:layout_marginTop="15dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BOUROU Melissa"
            android:textColor="@color/black"
            android:id="@+id/client_name"
            android:textSize="25dp"
            android:layout_gravity="center_horizontal">

        </TextView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/client_name"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="15dp"
            android:layout_gravity="center"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <ImageView
                    android:layout_width="75px"
                    android:layout_height="85px"
                    android:layout_marginTop="5px"
                    android:layout_marginRight="65px"
                    android:src="@drawable/order"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/order"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="25dp"
                    android:textColor="@color/text_color"
                    android:text="id order" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/order"
                android:layout_marginBottom="8dp"
                >

                <ImageView
                    android:layout_width="75px"
                    android:layout_height="85px"
                    android:layout_marginTop="5px"
                    android:layout_marginRight="65px"
                    android:src="@drawable/le_fournisseur"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/adr_four"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_color"
                    android:textSize="25dp"
                    android:text="adress fournisseur" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_below="@id/adr_four">

                <ImageView
                    android:layout_width="75px"
                    android:layout_height="85px"
                    android:layout_marginTop="5px"
                    android:layout_marginRight="65px"
                    android:src="@drawable/location"
                    app:tint="#777777" />

                <TextView
                    android:id="@+id/adr_client"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_color"
                    android:textSize="25dp"
                    android:text="adress client" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_below="@id/adr_four">

                <ImageView
                    android:layout_width="85px"
                    android:layout_height="85px"
                    android:layout_marginTop="5px"
                    android:layout_marginRight="65px"
                    android:src="@drawable/checkout"
                    app:tint="#777777" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_color"
                    android:textSize="25dp"
                    android:text="La commande" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="57dp"
                android:orientation="vertical">
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/recyclerview_order">

                </androidx.recyclerview.widget.RecyclerView>
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/black"/>
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total"
                        android:textSize="20dp"

                        android:textColor="@color/black"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_weight="1" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/totalPriceView"
                        android:text="2000 DA"
                        android:textSize="20dp"
                        android:textColor="@color/black"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/livPriceView"
            android:layout_marginStart="80dp"
            android:text="prix de la livraison: 400 DA"
            android:textSize="20dp"
            android:textColor="@color/black"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:gravity="center">

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="60px"
                android:backgroundTint="@color/orange"
                android:text="Accepter"
                android:id="@+id/acceptBtn"

                app:cornerRadius="8dp" />

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refusé"
                android:id="@+id/DeclineBtn"
                android:backgroundTint="#850000"
                app:cornerRadius="8dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Content of your bottom sheet goes here -->

</LinearLayout>
